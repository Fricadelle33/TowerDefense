effect: Reveal the top card of your deck. If it shares your element, draw it.
effect: Reveal your hand. For each water card revealed, Sap 1.

on_discard: If combo ≥ 3 → draw 1 card.     # conditional draw
on_discard: Draw 1 card, lose 2 buy energy.  # draw with a cost

# Slow scales with duration remaining — more stacks = longer slow
status_triggers:
  poisoned: Slow equal to stack count

# Push scales with duration — more stacks = bigger displacement  
status_triggers:
  poisoned: Push 1 per 2 stacks

# Unlock scales with duration — high stacks gate powerful effects
status_triggers:
  poisoned: If stack count ≥ 4 → Draw 1
